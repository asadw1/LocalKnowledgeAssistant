{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b-instruct"
  },
  "Agent": {
    "MaxIterations": 8,
    "RunTimeoutSeconds": 120,
    "MaxToolResultChars": 8000,
    "MaxIdenticalCalls": 2
  },
  "Indexing": {
    "Enabled": true,
    "Root": "../../sample-docs",
    "DatabasePath": "../../data/assistant.db",
    "IntervalMinutes": 5
  },
  "Mcp": {
    "Servers": [
      {
        "Name": "filesystem",
        "Command": "npx",
        "Args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "../../sample-docs"
        ],
        "ExcludeTools": [
          "write_file",
          "edit_file",
          "create_directory",
          "move_file"
        ]
      }
    ]
  }
}