{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5:7b-instruct"
  },
  "Mcp": {
    "Servers": [
      {
        "Name": "filesystem",
        "Command": "npx",
        "Args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "../../sample-docs"
        ],
        "ExcludeTools": [
          "write_file",
          "edit_file",
          "create_directory",
          "move_file"
        ]
      }
    ]
  }
}