<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" Version="1.81.0-alpha" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Prompts/*.md" />
    <EmbeddedResource Include="../../data/migrations/*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Assistant.Tests" />
  </ItemGroup>

</Project>
